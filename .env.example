# Bot tokenini shu yerga yozing (BotFather orqali olasiz)
BOT_TOKEN=1234567890:AAE-your-bot-token-here

# Majburiy a'zolik kanali:
#   - @ username yoki sonli ID (-100123...) bo'lishi mumkin
#   - Bot bu kanalga ADMIN qilib qo'shilgan bo'lishi SHART!
CHANNEL_ID=@kanal_username

# Kanalga o'tadigan havola ("A'zo bo'lish" tugmasida ishlatiladi)
CHANNEL_LINK=https://t.me/kanal_username

# MAXFIY kanal (qimmatli materiallar uchun).
# Bot shu kanalga ham ADMIN bo'lishi shart va kanalingda
# "Approve join requests" (A'zolik so'rovini tasdiqlash) YOQILGAN bo'lsin.
# Sonli ID yoziladi, masalan: -1001234567890
PRIVATE_CHANNEL_ID=-1001234567890

# Maxfiy kanalga o'tish havolasi (ixtiyoriy, fallback)
PRIVATE_CHANNEL_LINK=https://t.me/+ABCxyz

# Maxfiy kanalga kirish uchun nechta taklif kerak (standart: 5)
REQUIRED_REFERRALS=5

# Ixtiyoriy: bazaga boshqa nom/joy berish kerak bo'lsa
# DB_PATH=referral_bot.db